MODEL_BACKEND=locateanything
MODEL=Qwen/Qwen3-VL-32B-Instruct
DATA_DIR=../dataset
OUTPUT_ROOT=../outputs
RUN_NAME=grounding-run
BATCH_SIZE=128
SMOKE_LIMIT=2
GPU_IDS=0,1
LOCATEANYTHING_FEATURE_CACHE_SIZE=1
INTERNVL_DTYPE=bfloat16
INTERNVL_IMAGE_CACHE_SIZE=1
INTERNVL_MAX_NEW_TOKENS=128
# qwen_json | locateanything | internvl_json_union | internvl_native_box | internvl_minimal
# 这是全局 prompt profile；用不同 RUN_NAME 保存每组完整实验。
PROMPT_PROFILE=locateanything
